<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jasonsylvester.gp-nightly-scan</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jasonsylvester/Projects/astrojason/practice.astrojason.com/venv/bin/python3</string>
        <string>/Users/jasonsylvester/Projects/astrojason/practice-hub/scripts/nightly_gp_scan.py</string>
        <string>--env</string>
        <string>production</string>
    </array>

    <!-- Runs at 2:15 AM, after com.jasonsylvester.sheetmusic-cleanup (2:00 AM)
         has finished deduping/copying files, so the scan sees a settled
         folder. If the Mac was asleep, launchd runs on next wake instead of
         skipping it (unlike cron). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/jasonsylvester/Library/Logs/gp-nightly-scan.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jasonsylvester/Library/Logs/gp-nightly-scan-error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
